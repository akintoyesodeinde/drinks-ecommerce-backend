{
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": ""
  },
  "Store": {
    "Name": "DrinksEcommerce Nigeria",
    "Currency": "NGN",
    "TimeZone": "Africa/Lagos",
    "AlcoholSalesEnabled": false,
    "PickupEnabled": true,
    "VatRatePercent": 0,
    "ReservationExpiryMinutes": 30
  },
  "Jwt": {
    "Issuer": "DrinksEcommerce.API",
    "Audience": "DrinksEcommerce.Clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Payments": {
    "BaseUrl": "https://api.paystack.co/",
    "WebCallbackUrl": "http://localhost:5173/payment/verify",
    "MobileCallbackUrl": "drinksecommerce://payment/verify",
    "SimulatorBaseUrl": "http://localhost:5080",
    "TimeoutSeconds": 20,
    "VerifyBeforeWebhookCommit": true
  },
  "Email": {
    "Provider": "DevelopmentLog",
    "FromAddress": "no-reply@drinksecommerce.local",
    "FromName": "DrinksEcommerce Nigeria",
    "SmtpHost": "localhost",
    "SmtpPort": 1025,
    "UseSsl": false
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000",
      "http://localhost:8081",
      "http://localhost:19006"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AllowedHosts": "*"
}
