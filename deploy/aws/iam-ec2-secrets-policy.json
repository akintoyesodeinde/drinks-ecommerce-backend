{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowEC2InstanceToReadDrinksEcommerceProdSecretsOnly",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": [
        "arn:aws:secretsmanager:eu-north-1:415805875879:secret:drinks-ecommerce/prod/*"
      ]
    }
  ]
}
