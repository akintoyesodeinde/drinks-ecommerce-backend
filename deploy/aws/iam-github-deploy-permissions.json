{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowSSMSendCommandToDrinksEcommerceTaggedInstances",
      "Effect": "Allow",
      "Action": [
        "ssm:SendCommand"
      ],
      "Resource": [
        "arn:aws:ec2:eu-north-1:415805875879:instance/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "DrinksEcommerce"
        }
      }
    },
    {
      "Sid": "AllowSSMSendCommandOnRunShellScriptDocument",
      "Effect": "Allow",
      "Action": [
        "ssm:SendCommand"
      ],
      "Resource": [
        "arn:aws:ssm:eu-north-1::document/AWS-RunShellScript"
      ]
    },
    {
      "Sid": "AllowDescribeAndCommandStatusPolling",
      "Effect": "Allow",
      "Action": [
        "ssm:GetCommandInvocation",
        "ssm:ListCommandInvocations",
        "ec2:DescribeInstances"
      ],
      "Resource": "*"
    }
  ]
}
