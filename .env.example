# DrinksEcommerce Backend — Environment Configuration Template
# Copy to .env for local Docker Compose or configure in AWS Secrets Manager (drinks-ecommerce/prod/app-secrets) in production.
# NEVER commit real passwords, JWT signing keys, or Paystack secret keys to Git.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
TZ=Africa/Lagos

# SQL Server Connection String
ConnectionStrings__DefaultConnection=Server=sqlserver,1433;Database=DrinksEcommerceDb;User Id=sa;Password=CHANGE_ME_STRONG_SQL_PASSWORD;TrustServerCertificate=True;MultipleActiveResultSets=True;Encrypt=True

# Optional Redis Distributed Cache Connection String
ConnectionStrings__Redis=redis:6379,abortConnect=false

# Database Initialization & Seeding
Database__SkipAutoInitialize=false
Database__SeedCatalog=true
Database__SeedDemoAccounts=false

# Bootstrap Administrator (created on first startup if configured)
BootstrapAdmin__Email=admin@pinnaclesoftwareservices.store
BootstrapAdmin__Password=CHANGE_ME_STRONG_ADMIN_PASSWORD
BootstrapAdmin__FirstName=Store
BootstrapAdmin__LastName=Administrator
BootstrapAdmin__Phone=+2348030000000

# Store Policy Configuration
Store__Name=DrinksEcommerce Nigeria
Store__Currency=NGN
Store__TimeZone=Africa/Lagos
Store__AlcoholSalesEnabled=false
Store__PickupEnabled=true

# JWT Authentication (SigningKey must be at least 32 characters)
Jwt__Issuer=DrinksEcommerce.API
Jwt__Audience=DrinksEcommerce.Clients
Jwt__SigningKey=CHANGE_ME_GENERATE_AT_LEAST_64_BYTE_RANDOM_SECRET_KEY
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=14

# Paystack Integration (Keep in TEST mode until live mode is explicitly approved)
Payments__Provider=Paystack
Payments__BaseUrl=https://api.paystack.co/
Payments__PublicKey=pk_test_replace_with_your_paystack_test_public_key
Payments__SecretKey=sk_test_replace_with_your_paystack_test_secret_key
Payments__WebCallbackUrl=http://localhost/payment/verify
Payments__MobileCallbackUrl=drinksecommerce://payment/verify
Payments__VerifyBeforeWebhookCommit=true

# CORS Allowed Origins
Cors__AllowedOrigins__0=https://pinnaclesoftwareservices.store
Cors__AllowedOrigins__1=https://drinks.pinnaclesoftwareservices.store
Cors__AllowedOrigins__2=http://localhost:5173
Cors__AllowedOrigins__3=http://localhost:3000
